# Copy this file to server/.env and fill in real values.
# Never commit .env. Put the same values in Render / Vercel → Environment Variables.

# --- Required ---
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/genprep
JWT_SECRET=a-long-random-string-at-least-32-characters

# --- Server ---
PORT=5000
NODE_ENV=production
# 1 when running behind Render / Vercel (correct visitor IPs for login limits)
TRUST_PROXY=1

# --- Email (password reset codes) ---
BREVO_API_KEY=
EMAIL_FROM=GenPrep <no-reply@genprep.online>

# --- Images ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Nightly sync (GitHub Action calls /api/sync/cron with this) ---
CRON_SECRET=a-long-random-string
SUPABASE_WEBHOOK_SECRET=

# --- Question Bank Portal (Supabase). Repeat with 2, 3 … for more databases ---
SUPABASE_1_NAME=qbp
SUPABASE_1_DB_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# or, instead of the DB URL:
# SUPABASE_1_URL=https://xxxx.supabase.co
# SUPABASE_1_KEY=service-role-key
# Optional: SUPABASE_1_TABLE=questions  SUPABASE_1_SCHEMA=public  SUPABASE_1_UPDATED_COLUMN=updated_at
